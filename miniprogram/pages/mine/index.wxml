<view class="page"><view class="header" style="padding-top:{{statusBarHeight}}px"><text class="title">我的</text></view><view class="main"><view wx:if="{{isLoggedIn}}" class="profile-card"><view class="user-top"><image class="avatar" src="{{displayAvatar}}" mode="aspectFill"/><view class="user-info"><view class="name-line"><text class="name">{{displayName}}</text><image wx:for="{{identityBadges}}" wx:key="key" class="identity-badge" src="{{item.icon}}"/></view><text class="id" bindtap="copyUserId">用户ID：{{displayUserId}}</text></view><view class="actions"><button bindtap="goEditInfo">编辑名片</button><button open-type="share">分享名片</button></view></view><view class="membership" bindtap="onOpenMember"><image src="/assets/mine/member.png"/><view class="member-copy"><text class="member-title">{{isMemberOpened ? '钻石会员' : '开通会员'}}</text><text class="member-desc">解锁资源下载、发布、分销等全部权益</text></view><view class="expiry"><text>有效期至</text><text>{{memberExpiry}}</text></view></view><view class="stats"><view class="stat" bindtap="goMyFollowing"><image src="/assets/mine/star.png"/><text class="stat-num">{{displayCollectionCount}}</text><text class="stat-name">我的收藏</text></view><view class="stat" bindtap="goMyCircles"><image src="/assets/mine/circles.png"/><text class="stat-num">{{displayCircleCount}}</text><text class="stat-name">我的圈子</text></view><view class="stat" bindtap="goMessages"><image src="/assets/mine/message.png"/><text class="stat-num">{{unreadMessageCount}}</text><text class="stat-name">我的消息</text></view><view class="stat" bindtap="goWallet"><image src="/assets/mine/wallet.png"/><text class="stat-num">{{displayWalletBalance}}</text><text class="stat-name">我的钱包</text></view></view></view><view wx:else class="guest-section"><image class="guest-logo" src="{{displayAvatar}}"/><text class="guest-text">登录后查看完整功能</text><button bindtap="goLogin">立即登录</button></view><view class="management-card"><view wx:for="{{visibleSettingList}}" wx:key="key" class="management-row" data-key="{{item.key}}" bindtap="onSettingTap"><image class="row-icon" src="{{item.iconPath}}" mode="aspectFit"/><view class="row-copy"><text class="row-title">{{item.label}}</text><text wx:if="{{item.description}}" class="row-description">{{item.description}}</text></view><image class="row-arrow" src="/assets/mine/chevron.png"/></view></view><button class="publish-button" bindtap="goPublish">发布资源</button></view></view>