<view class="resource-card" hover-class="resource-card-active" bindtap="onTap">
  <view class="card-header">
    <view class="header-left">
      <text class="type-badge type-{{item.type}}">{{item.typeText}}</text>
      <text class="time-text">{{item.timeText}}</text>
    </view>
  </view>

  <text class="resource-title">{{item.title}}</text>
  <text wx:if="{{item.content}}" class="resource-desc">{{item.content}}</text>

  <view class="card-footer">
    <view wx:if="{{item.industryLabels.length}}" class="tags-row">
      <text
        wx:for="{{item.industryLabels}}"
        wx:for-item="label"
        wx:key="*this"
        class="industry-tag"
      >{{label}}</text>
    </view>

    <view wx:if="{{!item.avatars.length}}" class="stats-row">
      <text class="stat-text">{{item.readers}} 阅读</text>
    </view>
  </view>
</view>
