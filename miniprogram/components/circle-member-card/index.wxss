.member-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.member-card-active {
  background: #f8f8f8;
}

.member-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #f1f5f9;
  flex-shrink: 0;
}

.member-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.member-name {
  max-width: 320rpx;
  color: #0f172a;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  line-height: 1.3;
  font-weight: 500;
}

.badge-owner {
  background: rgba(26, 87, 219, 0.08);
  color: #1a57db;
}

.badge-verified {
  background: rgba(16, 185, 129, 0.1);
  color: #059669;
}

.member-meta {
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-intro {
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
