<view class="circle-card" hover-class="circle-card-active" bindtap="onTap">
  <view class="card-header">
    <image
      wx:if="{{displayCover}}"
      class="circle-cover"
      src="{{displayCover}}"
      mode="aspectFill"
      binderror="onCoverError"
    />
    <view wx:else class="circle-cover circle-cover-placeholder"></view>

    <view class="header-content">
      <view class="title-row">
        <text class="circle-title">{{item.title}}</text>
        <text wx:if="{{item.ownerCity}}" class="city-tag">{{item.ownerCity}}</text>
      </view>

      <text wx:if="{{item.industryLabel}}" class="industry-tag">{{item.industryLabel}}</text>

      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-value">{{item.members}}</text>
          <text class="stat-label">成员</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{item.posts}}</text>
          <text class="stat-label">动态</text>
        </view>
        <view wx:if="{{item.interested}}" class="collected-flag">
          <text class="collected-text">已收藏</text>
        </view>
      </view>
    </view>
  </view>

  <text wx:if="{{item.description}}" class="circle-desc">{{item.description}}</text>
</view>
