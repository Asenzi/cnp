.empty-state {
  padding: 120rpx 40rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.empty-icon-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 12rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 36rpx;
  color: #1e293b;
  margin-top: 8rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  line-height: 32rpx;
  color: #94a3b8;
  text-align: center;
  max-width: 400rpx;
}
